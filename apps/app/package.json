{
	"name": "app",
	"version": "0.1.0",
	"description": "Starter desktop app",
	"author": "Starter",
	"type": "module",
	"private": true,
	"main": "electron/main.cjs",
	"scripts": {
		"dev": "next dev --port 3001",
		"dev:next": "next dev --port 3001",
		"dev:electron": "ELECTRON_DEV_URL=http://localhost:3001 electron .",
		"build": "next build",
		"build:desktop": "next build && electron-builder --mac",
		"start": "next start",
		"check": "ultracite check",
		"fix": "ultracite fix",
		"check-types": "next typegen && tsc --noEmit"
	},
	"build": {
		"appId": "com.starter.app",
		"productName": "Starter",
		"asar": true,
		"files": [
			".env*",
			".next/**",
			"public/**",
			"electron/**",
			"next.config.js",
			"package.json",
			"node_modules/**",
			"!**/node_modules/.cache/**",
			"!**/node_modules/**/test/**",
			"!**/node_modules/**/__tests__/**",
			"!**/node_modules/**/docs/**",
			"!**/node_modules/**/examples/**",
			"!**/node_modules/**/src/**",
			"!**/*.map"
		],
		"protocols": [
			{
				"name": "Starter",
				"schemes": [
					"starter"
				]
			}
		],
		"mac": {
			"target": [
				"dmg"
			]
		}
	},
	"dependencies": {
		"@convex-dev/react-query": "^0.1.0",
		"@repo/backend": "*",
		"@repo/shared": "*",
		"@repo/ui": "*",
		"@tanstack/react-form": "^1.27.7",
		"@tanstack/react-query": "^5.90.16",
		"@toolwind/corner-shape": "^0.0.8-3",
		"convex": "^1.31.2",
		"motion": "^12.24.12",
		"next": "16.0.10",
		"next-themes": "^0.4.6",
		"react": "^19.2.2",
		"react-dom": "^19.2.2",
		"resend": "^6.6.0",
		"zod": "^4.3.4"
	},
	"devDependencies": {
		"@repo/biome-config": "^",
		"@repo/typescript-config": "*",
		"@tailwindcss/postcss": "^4.1.18",
		"@types/node": "^22.15.3",
		"@types/react": "19.2.2",
		"@types/react-dom": "19.2.2",
		"babel-plugin-react-compiler": "^1.0.0",
		"electron": "37.4.0",
		"electron-builder": "^26.0.16",
		"tailwindcss": "^4.1.11",
		"typescript": "5.9.2"
	}
}
