#!/bin/sh
# ultracite
set -e

if [ -d "$HOME/.bun/bin" ]; then
  export PATH="$HOME/.bun/bin:$PATH"
fi

if git diff --cached --quiet --diff-filter=ACMR; then
  echo "No staged files to check"
  exit 0
fi

if ! bun run check; then
  echo "Ultracite found issues. Run 'bun run fix', review the changes, and stage them explicitly."
  exit 1
fi

echo "Ultracite checks passed"
# ultracite end
