{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mrk.us/starter/manifest.schema.json",
  "title": "Composable starter manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "preset",
    "units",
    "selectionRules",
    "ownership",
    "variants",
    "packageDependencies",
    "environment",
    "rootScripts",
    "validation"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "preset": { "type": "string", "minLength": 1 },
    "units": { "type": "object", "minProperties": 1 },
    "selectionRules": {
      "type": "array",
      "items": { "type": "string" }
    },
    "ownership": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["unit", "include"],
        "properties": {
          "unit": { "type": "string" },
          "framework": { "enum": ["next", "tanstack"] },
          "include": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "variants": { "type": "array" },
    "packageDependencies": { "type": "object" },
    "environment": { "type": "object" },
    "rootScripts": { "type": "object" },
    "validation": { "type": "object" }
  },
  "additionalProperties": true
}
