{
  "name": "starter-monorepo-workos-stripe",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:desktop": "turbo run build:desktop --filter=desktop",
    "check": "ultracite check",
    "dev": "turbo run dev",
    "dev:desktop": "turbo run dev:app dev:electron --filter=app --filter=desktop",
    "doctor": "ultracite doctor",
    "fix": "ultracite fix",
    "prepare": "husky",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@repo/typescript-config": "workspace:*",
    "husky": "^9.1.7",
    "turbo": "^2.10.11",
    "typescript": "^7.0.2",
    "ultracite": "7.10.6"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.11.0"
  }
}
