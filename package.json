{
  "name": "starter-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:desktop": "turbo run build:desktop --filter=desktop",
    "check": "ultracite check",
    "dev": "turbo run dev",
    "dev:desktop": "turbo run dev:app dev:electron --filter=app --filter=desktop",
    "doctor": "ultracite doctor",
    "fix": "ultracite fix",
    "prepare": "husky",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@repo/typescript-config": "workspace:*",
    "convex": "^1.51.0",
    "convex-test": "^0.0.73",
    "husky": "^9.1.7",
    "turbo": "^2.11.13",
    "typescript": "^7.0.2",
    "ultracite": "8.3.1"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=26.0.0"
  }
}
