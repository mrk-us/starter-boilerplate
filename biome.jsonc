{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next",
    "ultracite/biome/tanstack"
  ],
  "files": {
    "includes": [
      "!!.agents/skills",
      "!!.claude/skills",
      "!!.starter/**/routeTree.gen.ts",
      "!!packages/backend/convex/_generated"
    ]
  },
  "linter": {
    "rules": {
      // Keep existing syntax and class ordering during the toolchain migration.
      "style": { "useNamedCaptureGroup": "off", "useUnicodeRegex": "off" },
      "nursery": { "useTailwindSortedClasses": "off" },
      "performance": {
        // Workspace and feature entry points intentionally expose public modules.
        "noBarrelFile": "off",
        // React Compiler and render-prop APIs already handle inline callbacks.
        "noJsxPropsBind": "off"
      },
      "suspicious": {
        // This rejects valid ReactNode branches and upstream shadcn conditions.
        "noLeakedRender": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [".starter/variants/**"],
      "linter": {
        "rules": {
          "correctness": {
            // Variants inherit their dependencies after materialization.
            "noUndeclaredDependencies": "off"
          }
        }
      }
    },
    {
      "includes": ["**/router.tsx"],
      "linter": {
        "rules": {
          "correctness": {
            // TanStack creates each router and its providers once per instance.
            "noComponentHookFactories": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/ui/**/*.css"],
      "assist": { "actions": { "source": { "useSortedProperties": "off" } } },
      "css": {
        "parser": {
          "tailwindDirectives": true
        }
      },
      "linter": {
        "rules": {
          "suspicious": {
            "noUnknownAtRules": "off",
            "useBaseline": "off",
            "noDuplicateSelectors": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/backend/convex/**/*"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "filenameCases": ["camelCase"]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        ".starter/units/app-tanstack/**/*.tsx",
        ".starter/variants/app-tanstack/**/*.tsx"
      ],
      "linter": {
        "rules": {
          "performance": {
            "noImgElement": "off"
          },
          "style": {
            "noHeadElement": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/ui/src/components/label.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/ui/src/components/field.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "noLabelWithoutControl": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/ui/src/components/input-group.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noNoninteractiveElementInteractions": "off",
            "useKeyWithClickEvents": "off",
            "useSemanticElements": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/ui/src/components/popover.tsx"],
      "linter": {
        "rules": {
          "suspicious": {
            // The two event handlers communicate through a ref across events.
            "noUnnecessaryConditions": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/app/features/billing/components/checkout-success-handler.tsx"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            // The callback sets the ref after its first execution.
            "noUnnecessaryConditions": "off"
          }
        }
      }
    },
    {
      "includes": [
        ".starter/units/app-tanstack/src/features/billing/components/checkout-success-handler.tsx"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            // The callback sets the ref after its first execution.
            "noUnnecessaryConditions": "off"
          }
        }
      }
    }
  ]
}
